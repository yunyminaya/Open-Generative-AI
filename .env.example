# Copy this file to .env and fill in the values you need.
# None of these are required to start the app — Muapi keys can also be
# entered directly in the UI on first use (stored in localStorage/session).

# Server-side Muapi.ai API key, used by middleware/API routes that proxy
# requests to api.muapi.ai instead of calling it from the client.
# Get a key at https://muapi.ai/access-keys
MUAPI_KEY=
